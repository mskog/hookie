{
	"name": "hookie",
	"displayName": "Hookie",
	"version": "0.0.1",
	"description": "A basic Plasmo extension.",
	"author": "Magnus Skog",
	"scripts": {
		"dev": "plasmo dev",
		"build": "plasmo build",
		"package": "plasmo package"
	},
	"dependencies": {
		"plasmo": "0.90.5",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"uuid": "^10.0.0"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "4.1.1",
		"@types/chrome": "^0.3.4",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "19.2.3",
		"@types/uuid": "^10.0.0",
		"prettier": "3.2.4",
		"tailwindcss": "^3.4.7",
		"typescript": "^7.0.2"
	},
	"manifest": {
		"host_permissions": [
			"https://*/*"
