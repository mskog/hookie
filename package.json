{
  "name": "hookie",
  "displayName": "Hookie",
  "version": "0.0.1",
  "description": "Custom context menu actions that open or call URLs with the clicked page, selection, link or media.",
  "author": "Magnus Skog",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.8.2"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "contextMenus",
      "storage",
      "tabs",
      "notifications"
    ]
  }
}
